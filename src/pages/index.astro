---
import "../styles/global.css";
import BirthdayFinale from "../components/BirthdayFinale.astro";
import BeginningSection from "../components/BeginningSection.astro";
import FirstMeetup from "../components/FirstMeetup.astro";
import SecondMeetup from "../components/SecondMeetup.astro";
import Iscoms from "../components/Iscoms.astro";
import Bengali from "../components/Bengali.astro";
import Talents from "../components/Talents.astro";
import Football from "../components/Football.astro";
import Doctor from "../components/Doctor.astro";
import Hero from "../components/Hero.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101724" />
    <meta
      name="description"
      content="A little birthday universe for Avanti, written in stars."
    />
    <title>Avanti — A Little Universe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,20,1;9..144,500,20,1;9..144,600,20,1&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    />
    <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
  </head>
  <body class="w-full paper" style="background: rgb(23, 33, 51);">
    <audio id="birthday-song" loop preload="none">
      <source src="/audio/hbd.mp3" type="audio/mpeg" />
    </audio>

    

    <main class="w-full">
      <button
      id="music-toggle"
      class="music-toggle"
      type="button"
      aria-pressed="false"
      aria-label="Play birthday music"
    >
      <span id="music-toggle-symbol" class="line-through" aria-hidden="true">♫</span>
    </button>
      <!-- Hero -->
      <Hero />

      <!-- Beginning -->
      <BeginningSection />

      <!-- First Meetup -->
      <FirstMeetup />

      <!-- Second Meet -->
      <SecondMeetup />

      <!-- ISCOMS -->
      <Iscoms />

      <!-- Bengali -->
      <Bengali />

      <!-- Talents -->
      <Talents />

      <!-- Football -->
      <Football />

      <!-- Doctor -->
      <Doctor />

      <!-- Cake -->
      <BirthdayFinale />
      <div class="glow" style="bottom:-140px;right:5%;background:#c8947050">
      </div>
    </main>
    <script>
      const audio = document.getElementById(
        "birthday-song",
      ) as HTMLAudioElement;
      const button = document.getElementById(
        "music-toggle",
      ) as HTMLButtonElement;
      const label = document.getElementById("music-toggle-label");
      const symbol = document.getElementById("music-toggle-symbol");

      button?.addEventListener("click", async () => {
        if (!audio) return;

        if (audio.paused) {
          try {
            await audio.play();
            button.setAttribute("aria-pressed", "true");
            button.setAttribute("aria-label", "Pause birthday music");
            symbol?.classList.remove("line-through");
            if (label) label.textContent = "Pause birthday music";
          } catch (error) {
            console.error("Could not play birthday music:", error);
          }
        } else {
          audio.pause();
          button.setAttribute("aria-pressed", "false");
          button.setAttribute("aria-label", "Play birthday music");
          symbol?.classList.add("line-through");
          if (label) label.textContent = "Play birthday music";
        }
      });
    </script>
  </body>
</html>
