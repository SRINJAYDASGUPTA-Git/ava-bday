<section
    class="canva-section starfield chapter flex items-center justify-center text-center"
    data-template-id="hero-section"
    id="top"
    style="min-height: calc(96 * min(var(--vh, 1vh), 1vh)); background: radial-gradient(rgb(48, 63, 90), rgb(16, 23, 36));"
>
    <div class="glow" style="top:18%;left:12%"></div>
    <div class="orbit hero-orbit"></div>
    <div class="orbit hero-orbit"></div>
    <div class="chapter-inner flex flex-col items-center">
        <span
            class="canva-text eyebrow reveal mb-8"
            data-template-id="hero-kicker"
            style="color: rgb(228, 205, 164); font-weight: 700; font-style: normal; font-size: 13px;"
            >A birthday story, written in stars</span
        >
        <span aria-hidden="true" class="reveal text-[#ddc38e] text-3xl mb-6"
            >✦ &middot; ✧ &middot; ✦</span
        >
        <h1
            class="canva-text chapter-title reveal reveal-delay max-w-4xl"
            data-template-id="hero-title"
            style="color: rgb(255, 249, 237); font-weight: 500; font-style: normal; font-size: 34px;"
        >
            Welcome to Your Little Universe
        </h1>
        <p
            class="canva-text serif reveal reveal-delay mt-4"
            data-template-id="hero-name"
            style="color: rgb(235, 207, 191); font-weight: 400; font-style: normal; font-size: 28px;"
        >
            For Avanti, with all my heart.
        </p>
        <div class="fine-rule my-9"></div>
        <p
            class="canva-text body-copy max-w-xl"
            data-template-id="hero-message"
            style="color: rgb(244, 234, 221); font-weight: 400; font-style: normal; font-size: 17px;"
        >
            Happy birthday, Avanti. Here is a little place for the memories we
            hold close, the things you love, and all the beautiful possibilities
            ahead.
        </p><a
            class="canva-link scroll-pill mt-11"
            data-template-id="hero-scroll"
            href="#beginning"
            style="color: rgb(255, 244, 223); font-weight: 600; font-style: normal; font-size: 15px;"
            >Come wander through your story &darr;</a
        >
    </div><span
        aria-hidden="true"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 text-[#dbc89f]"
        >✧</span
    >
</section>
