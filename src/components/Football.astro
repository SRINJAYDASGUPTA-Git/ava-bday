<section
    class="canva-section chapter relative"
    data-template-id="football-section"
    id="football"
    style="background:#131e31"
>
    <div
        class="absolute inset-0 pointer-events-none"
        style="background:radial-gradient(circle at 18% 18%,#c7a26c22,transparent 35%),radial-gradient(circle at 85% 85%,#a9576620,transparent 36%)"
    >
    </div>
    <div class="chapter-inner">
        <div class="text-center max-w-3xl mx-auto mb-14">
            <p
                class="canva-text eyebrow mb-5"
                data-template-id="football-kicker"
                style="color: rgb(221, 195, 148); font-weight: 700; font-style: normal; font-size: 13px;"
            >
                A chapter all its own
            </p>
            <h2
                class="canva-text chapter-title"
                data-template-id="football-title"
                style="color: rgb(255, 248, 236); font-weight: 500; font-style: normal; font-size: 26px;"
            >
                The Beautiful Game
            </h2>
            <p
                class="canva-text serif mt-7"
                data-template-id="football-intro"
                style="color: rgb(242, 223, 195); font-weight: 400; font-style: normal; font-size: 25px;"
            >
                For the girl who knows that some magic wears the number 10.
            </p>
        </div>
        <div class="grid md:grid-cols-2 gap-6 lg:gap-9">
            <article
                class="canva-card football-card flex flex-col"
                data-template-id="barcelona-card"
                style="background:#252e3d"
            >
                <div
                    class="football-stripes h-56 flex items-center justify-center relative overflow-hidden"
                >
                    <div aria-hidden="true" class="football-ball"></div><span
                        aria-hidden="true"
                        class="absolute top-5 right-7 text-[#f5dfb9] text-3xl"
                        >✦</span
                    >
                </div>
                <div class="p-8 sm:p-10 flex-1">
                    <p
                        class="canva-text eyebrow mb-4"
                        data-template-id="barcelona-eyebrow"
                        style="color: rgb(229, 183, 183); font-weight: 700; font-style: normal; font-size: 12px;"
                    >
                        A heart in red and blue
                    </p>
                    <h3
                        class="canva-text serif"
                        data-template-id="barcelona-title"
                        style="color: rgb(248, 241, 230); font-weight: 400; font-style: normal; font-size: 33px;"
                    >
                        FC Barcelona
                    </h3>
                    <p
                        class="canva-text mt-4"
                        data-template-id="barcelona-caption"
                        style="color: rgb(232, 197, 195); font-weight: 400; font-style: normal; font-size: 19px;"
                    >
                        Blaugrana forever.
                    </p>
                </div>
            </article>
            <article
                class="canva-card football-card flex flex-col"
                data-template-id="messi-card"
                style="background:#252e3d"
            >
                <div
                    class="h-56 flex items-center justify-center relative overflow-hidden"
                    style="background:radial-gradient(circle at center,#354154,#202a3b)"
                >
                    <span aria-hidden="true" class="ten">10</span>
                    <span
                        aria-hidden="true"
                        class="absolute top-5 left-7 text-[#d7b878] text-3xl"
                        >✧</span
                    >
                </div>
                <div class="p-8 sm:p-10 flex-1">
                    <p
                        class="canva-text eyebrow mb-4"
                        data-template-id="messi-eyebrow"
                        style="color: rgb(215, 184, 120); font-weight: 700; font-style: normal; font-size: 12px;"
                    >
                        A number full of wonder
                    </p>
                    <h3
                        class="canva-text serif"
                        data-template-id="messi-title"
                        style="color: rgb(248, 241, 230); font-weight: 400; font-style: normal; font-size: 33px;"
                    >
                        Lionel Messi
                    </h3>
                    <p
                        class="canva-text mt-4"
                        data-template-id="messi-caption"
                        style="color: rgb(223, 201, 159); font-weight: 400; font-style: normal; font-size: 19px;"
                    >
                        A little football magic.
                    </p>
                </div>
            </article>
        </div>
        <div class="flex justify-center my-11">
            <span aria-hidden="true" class="text-[#dbbe86] text-3xl">✦</span>
        </div>
        <p
            class="canva-text serif text-center max-w-3xl mx-auto"
            data-template-id="football-closing"
            style="color: rgb(247, 232, 205); font-weight: 400; font-style: normal; font-size: 26px;"
        >
            May every year bring last-minute winners, beautiful goals, and
            reasons to cheer.
        </p>
        <div class="flex justify-center mt-12">
            <a
                aria-label="Continue to the future"
                class="canva-link section-next"
                data-template-id="football-next"
                href="#doctor"
                style="color: rgb(255, 244, 223); font-weight: 600; font-style: normal; font-size: 15px;"
                >Next chapter &darr;</a
            >
        </div>
    </div>
</section>
